        "before": "    # Same operations as the executed JQ proposal card; no detached basis.\n    def factor(A):\n        cn = (A.to(torch.float64) ** 2).sum(0)\n        cols = torch.sort(torch.argsort(-cn, stable=True)[:32]).values\n        Q = torch.linalg.qr(A[:, cols])[0]\n        Q = torch.linalg.qr(A @ torch.linalg.qr(A.T @ Q)[0])[0]\n        return Q, Q.T @ A",
        "after": "    # Same forward operations; only the basis gradient follows Opus's detached rule.\n    def factor(A):\n        with torch.no_grad():\n            Ad = A.detach()\n            cn = (Ad.to(torch.float64) ** 2).sum(0)\n            cols = torch.sort(torch.argsort(-cn, stable=True)[:32]).values\n            Q = torch.linalg.qr(Ad[:, cols])[0]\n            Q = torch.linalg.qr(Ad @ torch.linalg.qr(Ad.T @ Q)[0])[0]\n        return Q, Q.T @ A"
      },
